# MaintAI Docker Compose 环境变量模板
# 复制为仓库根目录 .env 后修改所有密码、令牌和 API Key。

# 对外端口
FRONTEND_PORT=80
JAVA_PORT=8080
FIXAGENT_PORT=8000
MYSQL_PORT=3306
REDIS_PORT=6379
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# MySQL（项目现有 SQL 使用 fix 数据库）
MYSQL_DATABASE=fix
MYSQL_ROOT_PASSWORD=change_me

# Neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_me_neo4j
NEO4J_DATABASE=neo4j

# RabbitMQ
RABBITMQ_USER=maintai
RABBITMQ_PASSWORD=change_me_rabbitmq

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_DOCUMENT_BUCKET=weixiu-private-wendang
MINIO_PUBLIC_IMAGE_BUCKET=weixiu-public-tupian

# FixAgent / Java 共享配置
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
RAG_VARIANT=production
CLARIFICATION_MODE=enforce
IMAGE_SUMMARY_LLM_ENABLED=true
API_TOKEN=replace_with_random_fixagent_api_token
INTERNAL_TOKEN=replace_with_different_random_internal_token

# 可选模型和图谱参数
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
GRAPH_JAVA_REQUEST_BUDGET_SECONDS=10
GRAPH_CLIENT_TIMEOUT_SECONDS=20
GRAPH_QUALITY_HIGH_THRESHOLD=0.85
GRAPH_QUALITY_MEDIUM_THRESHOLD=0.70

# 邮件/阿里云 OSS 等业务可选配置
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
